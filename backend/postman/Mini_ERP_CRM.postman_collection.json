            ],
            "url": {
              "raw": "{{baseUrl}}/customers?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["customers"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Search Customers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers?search=rajesh",
              "host": ["{{baseUrl}}"],
              "path": ["customers"],
              "query": [
                { "key": "search", "value": "rajesh" }
              ]
            }
          }
        },
