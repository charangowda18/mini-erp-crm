              "raw": "{\n  \"name\": \"Test Customer\",\n  \"mobile\": \"9876543299\",\n  \"email\": \"test@customer.com\",\n  \"business_name\": \"Test Business Pvt Ltd\",\n  \"gst_number\": \"29TESTG1234F1Z5\",\n  \"customer_type\": \"Wholesale\",\n  \"address\": \"Test Address, City 560001\",\n  \"status\": \"Lead\",\n  \"follow_up_date\": \"2026-08-20\",\n  \"notes\": \"New potential client\"\n}"
            },
            "url": {
